<?xml version="1.0" encoding="UTF-8"?>
<server description="hello-liberty">

  <!-- Alleen de features die de app nodig heeft: dat houdt het image klein (vs. 'alles aan' op WAS) -->
  <featureManager>
    <feature>restfulWS-3.1</feature>
    <feature>mpHealth-4.0</feature>
  </featureManager>

  <!-- host="*" is nodig in een container, anders luistert Liberty alleen op localhost -->
  <httpEndpoint id="defaultHttpEndpoint" host="*" httpPort="9080" httpsPort="-1"/>

  <webApplication location="hello.war" contextRoot="/"/>

</server>
